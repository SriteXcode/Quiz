{
  "name": "quizmaster-monorepo",
  "version": "1.0.0",
  "description": "Production-grade Full-Stack Developer Assessment, Quiz & Short Gyaan Platform",
  "private": true,
  "scripts": {
    "dev:backend": "cd backend && npm run dev",
    "dev:client": "cd Client && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:client\"",
    "build:client": "cd Client && npm run build",
    "build": "npm run build:client",
    "install:all": "cd backend && npm install && cd ../Client && npm install",
    "lint": "cd Client && npm run lint"
  },
  "keywords": [
    "quiz",
    "assessment",
    "code-challenge",
    "short-gyaan",
    "react19",
    "vite",
    "express",
    "mongodb",
    "proctoring",
    "certificates"
  ],
  "author": "QuizMaster Engineering Team",
  "license": "MIT"
}
